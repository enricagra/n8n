    {
      "parameters": {
        "jsCode": "const raw = $json.result[0].value;\n\n// 1. Hiwalayin ang \"LOW_SCORE\" na line at \"FAILED\" na line\nconst lines = raw.split('\\n');\nconst scoreLine = lines[0].replace('LOW_SCORE: ', '');\nconst failedLine = lines[1].replace('FAILED: ', '');\n\n// 2. Himayin ang Scores per machine\nconst scores = scoreLine.split(' | ').map(item => {\n    const parts = item.split('(');\n    return {\n        hostname: parts[0].trim(),\n        score: parts[1].replace('%)', '') + \"%\"\n    };\n});\n\n// 3. Himayin ang Failed counts per machine\nconst failed = failedLine.split(' | ').map(item => {\n    const parts = item.split('(');\n    return {\n        hostname: parts[0].trim(),\n        failed_checks: parts[1].replace(')', '')\n    };\n});\n\n// 4. Pagsamahin sila sa isang malinis na listahan\nreturn scores.map(s => {\n    const f = failed.find(item => item.hostname === s.hostname) || { failed_checks: \"0\" };\n    return {\n        json: {\n            host: s.hostname,\n            score: s.score,\n            failed: f.failed_checks,\n            status: parseInt(s.score) < 40 ? \"\u26a0\ufe0f CRITICAL\" : \"OK\"\n        }\n    };\n});"
      },
